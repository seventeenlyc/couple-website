# 上传的文件
uploads/photos/*
uploads/avatars/*
uploads/private/*
!uploads/photos/.gitkeep
!uploads/avatars/.gitkeep
!uploads/private/.gitkeep
!uploads/private/.htaccess

# 数据文件（包含用户隐私）
data/*.json
!data/config.json.example
!data/ai_config.json.example
!data/.htaccess

# 日志文件
data/logs/*
!data/logs/.gitkeep

# 缓存文件
data/cache/*
!data/cache/.gitkeep

# 系统文件
.DS_Store
Thumbs.db
*.log

# IDE文件
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# SSL验证
.well-known/

# 服务器配置
.user.ini

# 临时文件
*.tmp
*.bak
*.backup

# 本地依赖、数据库与凭据（只保留在本机，不随源码提交）
node_modules/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.env
.env.*
!.env.example
*.pem
*.key

# 上传的派生资源和故事附件
uploads/thumbnails/*
uploads/story/*
